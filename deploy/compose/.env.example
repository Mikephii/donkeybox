# Copy to .env and fill in. Never commit .env.
WORKBENCH_IMAGE=ghcr.io/mikephii/donkeybox:0.5.0

# Where people and webhooks reach the box (what your TLS in front serves).
APP_URL=https://workbench.example.com
HOOKS_URL=https://hooks.workbench.example.com
# Only for the bundled TLS (docker compose --profile tls): the bare host names.
APP_DOMAIN=workbench.example.com
HOOKS_DOMAIN=hooks.workbench.example.com

# Your identity provider (Google, Microsoft Entra, Okta, Keycloak, Authentik, ...).
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# openssl rand -base64 32 | head -c 32
COOKIE_SECRET=
# Comma-separated domains allowed to sign in at the door, or * for any account the provider accepts.
ALLOWED_EMAIL_DOMAINS=example.com

# The first admin inside the workbench.
BOOTSTRAP_ADMIN=you@example.com

# The management API, published on this host's 127.0.0.1:8002 only. Needed for `wb update`;
# without a token (24+ characters) it stays off.
MANAGEMENT_TOKEN=
