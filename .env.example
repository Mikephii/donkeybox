# Local development. Copied to .env by scripts/setup.sh.
AUTH_MODE=dev
DEV_USER_EMAIL=dev@localhost
# Secrets the webhook sources verify against (names are referenced from workspace/config.json)
GITHUB_WEBHOOK_SECRET=dev-github-secret
JIRA_HOOK_SECRET=dev-jira-secret
DEPLOY_HOOK_SECRET=dev-deploy-secret
# Optional: comma-separated allow list; tokens for other emails are revoked nightly
# WB_ALLOWED_EMAILS=dev@localhost,alice@localhost
